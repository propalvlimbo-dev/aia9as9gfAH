# Скопируй в .env и заполни (на Pterodactyl можно просто задать переменные в разделе Environment)

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-xxxxxxxxxxxxxxxxxxxxxxx

# Адрес HTTP API плагина ElytrixAuth (VDS с NullCordX, порт из config.properties -> api.port)
API_BASE=http://IP_ТВОЕГО_VDS:8754

# Секрет — ОБЯЗАТЕЛЬНО тот же, что api.secret в config.properties плагина
API_KEY=CHANGE_ME

# Как часто опрашивать плагин о запросах входа (сек)
POLL_INTERVAL=2.0
