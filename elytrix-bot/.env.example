# Скопируй в .env и заполни (на Pterodactyl можно просто задать переменные в разделе Environment)

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAA-xxxxxxxxxxxxxxxxxxxxxxx

# Подключение к MariaDB (на VPS с NullCordX)
DB_HOST=1.2.3.4
DB_PORT=3306
DB_NAME=elytrix
DB_USER=elytrix_bot
DB_PASSWORD=СИЛЬНЫЙ_ПАРОЛЬ_БОТА

# Как часто опрашивать БД о запросах входа (сек)
POLL_INTERVAL=2.0
